# Surfer command file: the YAPP router signals in groups.
# Generated by scripts/surfer_layout.py -- edit LAYOUT there, not this file.
# Open a .fst first, then File -> Run command file... and pick this file.

# Clock, reset
item_unfocus
variable_add hw_top.reset
item_focus a
item_set_color Gray
group_marked
item_rename Clock, reset
item_set_color Gray
variable_add hw_top.clock
item_set_format Clock
item_set_color Gray

# Input port
item_unfocus
variable_add hw_top.dut.u_tracer.in_phase
item_focus d
item_set_color Green
group_marked
item_rename Input port
item_set_color Green
variable_add hw_top.in0.in_data
item_set_format Hexadecimal
item_set_color Green
variable_add hw_top.in0.in_data_vld
item_set_color Green
variable_add hw_top.in0.in_suspend
item_set_color Green

